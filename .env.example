# Copy this to .env and fill in real values. DO NOT commit .env.

# --- LLM (for synthesis) ---
# anthropic | openai | gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Web search provider ---
# tavily | serper | duckduckgo
WEB_SEARCH_PROVIDER=tavily
# https://tavily.com - free 1000 req/month
TAVILY_API_KEY=
# https://serper.dev - free 2500 req
# SERPER_API_KEY=
# (DuckDuckGo needs no key but the duckduckgo-search package must be installed.)

# --- SE-layer settings (you will populate these) ---
LOG_LEVEL=INFO
CACHE_DIR=./.cache
CACHE_TTL_SECONDS=86400
PER_SOURCE_TIMEOUT_SECONDS=10
MAX_SOURCES_PER_QUERY=3